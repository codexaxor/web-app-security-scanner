# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Database ---
SECSCAN_DB_URL=jdbc:postgresql://postgres:5432/secscan
SECSCAN_DB_USER=secscan
SECSCAN_DB_PASSWORD=secscan

# Used by the postgres container itself (keep in sync with the three vars above).
POSTGRES_DB=secscan
POSTGRES_USER=secscan
POSTGRES_PASSWORD=secscan

# Host port the postgres container is published on. Change it if a system Postgres already owns 5432.
POSTGRES_HOST_PORT=5432

# --- Secrets at rest ---
# AES-256 key for encrypting GitLab tokens (used from M1). Generate: openssl rand -base64 32
SECSCAN_ENCRYPTION_KEY=

# --- Outbound GitLab allowlist (SSRF guard, D-018) ---
# Comma-separated hosts the app may call. Empty = deny all outbound GitLab calls. https is required
# (loopback hosts may use http for a local/mock GitLab).
SECSCAN_GITLAB_ALLOWED_HOSTS=gitlab.celloscope.net

# --- First admin (D-011) ---
# On first startup, if no user exists and both are set, an admin is created in the default workspace.
# The password is never logged or stored in plaintext.
SECSCAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SECSCAN_BOOTSTRAP_ADMIN_PASSWORD=change-me
