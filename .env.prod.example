# VM deploy / internal-demo template (M8.9). Copy to `.env` ON THE VM and fill the blanks.
# NEVER commit the real .env (.gitignore already excludes it). Generate every secret FRESH on the VM
# with:  openssl rand -base64 32
#
# Use with:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# --- Database (stays inside the compose network; host port is loopback-only) ---
SECSCAN_DB_URL=jdbc:postgresql://postgres:5432/secscan
SECSCAN_DB_USER=secscan
SECSCAN_DB_PASSWORD=          # fresh: openssl rand -base64 32
POSTGRES_DB=secscan
POSTGRES_USER=secscan
POSTGRES_PASSWORD=            # SAME value as SECSCAN_DB_PASSWORD
# The VM already runs its own Postgres on 5432 — publish ours on a different loopback host port.
POSTGRES_HOST_PORT=15432

# --- Secrets at rest (generate fresh, keep only here) ---
SECSCAN_ENCRYPTION_KEY=       # openssl rand -base64 32 (AES-256 for GitLab tokens)
SECSCAN_FINGERPRINT_KEY=      # openssl rand -base64 32 (HMAC for secret-finding hashes)

# --- Outbound GitLab allowlist (SSRF guard). GitHub needs no entry (public API). ---
SECSCAN_GITLAB_ALLOWED_HOSTS=gitlab.celloscope.net

# --- Scanner working dir (create + chown to the uid/gid below before first run) ---
SECSCAN_SCAN_WORK_ROOT=/var/lib/secscan/scans
# The VM's `ubuntu` user (verified): id -u / id -g
SECSCAN_UID=1001
SECSCAN_GID=1001
# Group id of /var/run/docker.sock on the VM (verified): stat -c %g /var/run/docker.sock
DOCKER_GID=988
# This worker's ownership tag + work-root subtree, so its reaper only touches its own leftovers.
SECSCAN_INSTANCE_ID=vm

# --- First admin (created on first boot when no user exists) ---
SECSCAN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com   # set your operator email on the VM
SECSCAN_BOOTSTRAP_ADMIN_PASSWORD=   # set on the VM only; never paste into chat or commit

# --- HTTP-only internal demo (M8.9 waiver: TLS declined) ---
# Served over plain http on the internal LAN, so the session cookie cannot be Secure. This is accepted
# for the internal demo ONLY; the cookie travels in cleartext on 172.16.4.0/22. Do NOT reuse this for
# any externally reachable or multi-tenant deployment.
SECSCAN_SESSION_COOKIE_SECURE=false
# Network-facing UI bind. On a multi-homed host (e.g. a VM with Docker bridge interfaces) bind the
# SPECIFIC internal IP, not 0.0.0.0, so the port is not published on the docker bridges. The VM uses:
SECSCAN_HTTP_BIND=172.16.6.73
# SECSCAN_HTTP_PORT=80

# Demo mode stays OFF on a shared host (login is the bootstrap admin above).
SECSCAN_DEMO_MODE=false
